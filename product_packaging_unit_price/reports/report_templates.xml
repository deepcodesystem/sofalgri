<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Note interne de la fiche client (à défaut celle de la société du contact),
         imprimée sous le client et son adresse. Variable attendue : partner. -->
    <template id="report_partner_note">
        <t t-set="partner_note" t-value="partner.comment if not is_html_empty(partner.comment) else partner.commercial_partner_id.comment"/>
        <div t-if="not is_html_empty(partner_note)" class="mt-2" t-out="partner_note"/>
    </template>

    <!-- ======================================================= -->
    <!--     REMPLACEMENT COMPLET DU TABLEAU DE LA FACTURE       -->
    <!-- ======================================================= -->
    <template id="report_invoice_document_inherit_packaging_replace" inherit_id="account.report_invoice_document">
        <!-- ======================================================= -->
        <!-- 1. SUPPRESSION DES CHAMPS DE L'EN-TÊTE (INCHANGÉ)      -->
        <!-- ======================================================= -->
        <xpath expr="//div[@name='due_date']" position="replace"/>
        <xpath expr="//div[@name='customer_code']" position="replace"/>
        <xpath expr="//div[@name='reference']" position="replace"/>
        <xpath expr="//div[@name='origin']" position="replace"/>
        <xpath expr="//div[@name='incoterm_id']" position="replace">
            <div class="col" t-if="o.invoice_incoterm_id" name="incoterm_id">
                <strong>Incoterm</strong>
                <div t-if="o.incoterm_location">
                    <span t-field="o.invoice_incoterm_id.code"/>
                    <span t-field="o.incoterm_location"/>
                </div>
                <div t-else="" t-field="o.invoice_incoterm_id.code" class="m-0"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='incoterm_id']" position="after">
            <div class="col" t-if="o.delivery_truck_number" name="delivery_truck_number">
                <strong>Matricule</strong>
                <div t-field="o.delivery_truck_number" class="m-0"/>
            </div>
        </xpath>

        <!-- Note interne du client sous son adresse (trois variantes du bloc adresse natif) -->
        <xpath expr="//div[@name='address_not_same_as_shipping']/t[@t-set='address']" position="inside">
            <t t-call="product_packaging_unit_price.report_partner_note"><t t-set="partner" t-value="o.partner_id"/></t>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']/t[@t-set='address']" position="inside">
            <t t-call="product_packaging_unit_price.report_partner_note"><t t-set="partner" t-value="o.partner_id"/></t>
        </xpath>
        <xpath expr="//div[@name='no_shipping']/t[@t-set='address']" position="inside">
            <t t-call="product_packaging_unit_price.report_partner_note"><t t-set="partner" t-value="o.partner_id"/></t>
        </xpath>

        <!-- ======================================================= -->
        <!-- 2. REMPLACEMENT DU TABLEAU DE LA FACTURE (INCHANGÉ)     -->
        <!-- ======================================================= -->
        <xpath expr="//table[@name='invoice_line_table']" position="replace">
            <!-- Tout votre code pour le nouveau tableau va ici. -->
            <!-- Je le remets pour que le code soit complet. -->
            <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
            <t t-set="display_taxe" t-value="any(line.tax_ids for line in o.invoice_line_ids)"/>
            <t t-set="display_calibre" t-value="any(line.product_id.calibre for line in o.invoice_line_ids)"/>
            <div class="oe_structure"/>
            <t t-set="has_long_desc" t-value="any(line.name and line.name.count('\n') &gt; 30 for line in o.invoice_line_ids if line.name)"/>
            <table class="o_has_total_table table o_main_table table-borderless mb-0" name="invoice_line_table"> <!-- table-borderless retiré pour voir les lignes -->
                <thead>
                    <tr style="font-size:14px;">
                        <th name="th_description" class="text-start"><span>Designation</span></th>
                        <th name="th_calibre" t-if="display_calibre" class="text-center"><span>Calibre</span></th>
                        <th name="th_nb_package" class="text-center"><span>Nbre Colis</span></th>
                        <th name="th_package" class="text-start"><span>Emballage</span></th>
                        <th name="th_quantity" class="text-center"><span>Poids Net</span></th>
                        <th name="th_priceunit" class="text-center text-nowrap"><span>Prix Unitaire</span></th>
                        <th name="th_subtotal" class="text-end"><span>Montant</span></th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-set="current_total" t-value="0"/>
                    <t t-set="current_total_qty" t-value="0"/>
                    <t t-set="current_total_package" t-value="0"/>
                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                    <t t-foreach="lines" t-as="line">
                        <t t-if="line.display_type == 'product'">
                             <t t-set="current_total_qty" t-value="current_total_qty + line.quantity"/>
                             <t t-set="current_total_package" t-value="current_total_package + line.product_packaging_qty"/>
                             <tr style="font-size:12px;">
                                <td name="account_invoice_line_name"><span t-field="line.product_id.description_sale"/></td>
                                <td t-if="display_calibre" class="text-center"><span t-field="line.product_id.calibre"/></td>
                                <td class="text-center"><span t-field="line.product_packaging_qty" t-options='{"widget": "float", "precision": 0}'/></td>
                                <!-- Description de vente du conditionnement, à défaut son nom (souvent la seule information renseignée) -->
                                <td class="text-start"><span t-out="line.product_packaging_id.description_sale or line.product_packaging_id.name or ''"/></td>
                                <td class="text-center">
                                    <span t-field="line.quantity" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                </td>
                                <td class="text-center">
                                    <span class="text-nowrap" t-field="line.price_unit_package" t-options='{"widget": "float", "precision": 4}'/>
                                </td>
                                <td class="text-end">
                                    <span class="text-nowrap" t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                    <!-- Ligne pour les totaux de colonnes -->
                    <tr style="border-top: 1px solid black; font-weight: bold;">
                        <td t-att-colspan="2 if display_calibre else 1"/>
                        <td class="text-center">
                            <span t-esc="int(current_total_package)" t-options='{"widget": "float", "precision": 0}'/>
                        </td>
                        <td/>
                        <td class="text-center">
                            <span t-esc="current_total_qty" t-options='{"widget": "float", "precision": 2}'/>
                        </td>
                        <td colspan="2"/>
                    </tr>
                </tbody>
            </table>
        </xpath>


        <!-- ======================================================= -->
        <!-- 3. REMPLACER TOUT LE PIED DE PAGE POUR RECRÉER LA MISE EN PAGE -->
        <!-- ======================================================= -->
        <xpath expr="//div[hasclass('overflow-hidden')]" position="replace">
            <div class="row" name="custom_footer" style="margin-top: 30px;">

                <!-- COLONNE DE GAUCHE : Vos informations personnalisées -->
                <div class="col-7">
                    <!-- ===== DÉBUT DE LA NOUVELLE LOGIQUE DE CALCUL DES PALETTES ===== -->

                    <!-- 1. Initialisation des compteurs pour chaque type de packaging -->
                    <t t-set="total_packages_220" t-value="0"/>
                    <t t-set="total_packages_100" t-value="0"/>

                    <!-- 2. On parcourt les lignes pour trier les colis par type -->
                    <t t-foreach="o.invoice_line_ids.filtered(lambda line: line.display_type == 'product')" t-as="line">
                        <!--
                            CONDITION À ADAPTER:
                            Ici, nous identifions l'emballage "100 par palette".
                            J'utilise un exemple basé sur le nom "PLASTIQUE".
                            Vous DEVEZ adapter cette condition à votre cas réel.
                        -->
                        <t t-if="line.product_packaging_id and 'PLASTIQUE' in line.product_packaging_id.name.upper()">
                            <t t-set="total_packages_100" t-value="total_packages_100 + line.product_packaging_qty"/>
                        </t>
                        <t t-else="">
                            <!-- Tous les autres emballages sont considérés comme 220 par palette -->
                            <t t-set="total_packages_220" t-value="total_packages_220 + line.product_packaging_qty"/>
                        </t>
                    </t>

                    <!-- 3. Calcul des palettes pour chaque catégorie -->
                    <t t-set="palettes_220" t-value="int((total_packages_220 + 219) // 220) if total_packages_220 > 0 else 0"/>
                    <t t-set="palettes_100" t-value="int((total_packages_100 + 99) // 100) if total_packages_100 > 0 else 0"/>

                    <!-- 4. Calcul du total final -->
                    <t t-set="total_palettes" t-value="palettes_220 + palettes_100"/>
                    <!-- ===== FIN DE LA NOUVELLE LOGIQUE ===== -->

                    <div name="GGN" class="mb-4">
                        Produits certifiés GLOBAL GAP + GGN : <strong><span t-field="o.company_id.number_ggn"/></strong>
                    </div>

                    <div name="shipping_information" class="mb-4">
                        <!-- Poids brut saisi sur la facture (défaut 24 250 kg) -->
                        Poids Brut Total: <strong><span t-field="o.gross_weight" t-options='{"widget": "float", "precision": 2}'/></strong><br/>
                        Poids Net Total: <strong><span t-esc="current_total_qty" t-options='{"widget": "float", "precision": 2}'/></strong><br/>
                        Nombre de pallettes total: <strong><span t-esc="int(total_palettes)" t-options='{"widget": "float", "precision": 0}'/></strong><br/>
                        Nombre de colis total: <strong><span t-esc="int(current_total_package)" t-options='{"widget": "float", "precision": 0}'/></strong>
                    </div>
                    <div name="payment_information">
                        Réglement à l'ordre de : <strong><span t-field="o.company_id.name"/></strong><br/>
                        Modalité de paiement : <strong><span t-field="o.preferred_payment_method_line_id.name"/></strong><br/>
                        <p style="margin-top: 8px;">Coordonnées bancaire :</p>
                        <div name="bank">
                            <t t-if="o.partner_bank_id">
                                RIB: <strong><span t-field="o.partner_bank_id.acc_number"/></strong><br/>
                                BIC - Code SWIFT: <strong><span t-field="o.partner_bank_id.code_swift"/></strong><br/>
                                IBAN: <strong><span t-field="o.partner_bank_id.iban"/></strong>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- COLONNE DE DROITE : Le bloc des totaux (repris du code standard Odoo) -->
                <div class="col-5">
                    <div id="total">
                        <table class="o_total_table table table-borderless avoid-page-break-inside">
                            <!-- Utilisation du template standard d'Odoo pour afficher les totaux -->
                            <t t-call="account.document_tax_totals">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <!-- LA LIGNE MANQUANTE EST ICI -->
                                <t t-set="currency" t-value="o.currency_id"/>
                            </t>
                        </table>
                    </div>
                    <p t-if="o.company_id.display_invoice_amount_total_words" class="text-end">
                        <strong>Montant total en toutes lettres :</strong><br/>
                        <span t-field="o.amount_total_words"/>
                    </p>
                </div>
            </div>
        </xpath>

    </template>
</odoo>
