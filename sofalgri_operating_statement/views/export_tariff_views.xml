<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_export_tariff_list" model="ir.ui.view">
        <field name="name">sofalgri.export.tariff.list</field>
        <field name="model">sofalgri.export.tariff</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="cost_type"/>
                <field name="name"/>
                <field name="amount"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_export_tariff" model="ir.actions.act_window">
        <field name="name">Tarifs d'export</field>
        <field name="res_model">sofalgri.export.tariff</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_export_tariff"
              name="Tarifs d'export"
              parent="menu_bi_finance"
              action="action_export_tariff"
              groups="account.group_account_manager"
              sequence="30"/>

    <record id="view_export_summary_list_truck_cost" model="ir.ui.view">
        <field name="name">account.move.export.summary.list.truck.cost</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="sofalgri_export_summary.view_export_summary_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='export_claim_amount']" position="after">
                <field name="company_currency_id" column_invisible="1"/>
                <field name="export_goods_cost" sum="Total" groups="account.group_account_manager"/>
                <field name="export_approach_cost" sum="Total" groups="account.group_account_manager"/>
                <field name="export_transport_cost" sum="Total" readonly="1" groups="account.group_account_manager"/>
                <field name="export_forwarder_cost" sum="Total" readonly="1" groups="account.group_account_manager"/>
                <field name="export_station_cost" sum="Total" readonly="1" groups="account.group_account_manager"/>
                <field name="export_total_cost" sum="Total" groups="account.group_account_manager"/>
                <field name="export_cost_per_kg" groups="account.group_account_manager"/>
                <field name="export_margin" sum="Total" groups="account.group_account_manager"
                       decoration-danger="export_margin &lt; 0" decoration-success="export_margin &gt; 0"/>
                <field name="export_margin_percent" groups="account.group_account_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_export_costs" model="ir.ui.view">
        <field name="name">account.move.form.export.costs</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <field name="is_export_invoice" invisible="1"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page name="export_costs" string="Coûts d'export" invisible="not is_export_invoice">
                    <group>
                        <group>
                            <field name="export_destination_id" options="{'no_create': True}"/>
                            <field name="export_transport_cost"/>
                            <field name="export_forwarder_cost"/>
                            <field name="export_station_cost"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
