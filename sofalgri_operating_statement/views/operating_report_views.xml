<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_operating_report_pivot" model="ir.ui.view">
        <field name="name">sofalgri.operating.report.pivot</field>
        <field name="model">sofalgri.operating.report</field>
        <field name="arch" type="xml">
            <pivot string="Compte d'exploitation" disable_linking="0">
                <field name="section" type="row"/>
                <field name="rubric" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_operating_report_list" model="ir.ui.view">
        <field name="name">sofalgri.operating.report.list</field>
        <field name="model">sofalgri.operating.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="currency_id" column_invisible="1"/>
                <field name="date"/>
                <field name="section"/>
                <field name="rubric"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="account_move_id"/>
                <field name="purchase_order_id"/>
                <field name="quantity" sum="Total"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_operating_report_search" model="ir.ui.view">
        <field name="name">sofalgri.operating.report.search</field>
        <field name="model">sofalgri.operating.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="rubric"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="current_season" string="Saison en cours" domain="[('current_season', '=', True)]"/>
                <separator/>
                <filter name="income" string="Produits" domain="[('section', '=', 'income')]"/>
                <filter name="cost" string="Charges" domain="[('section', '=', 'cost')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_rubric" string="Rubrique" context="{'group_by': 'rubric'}"/>
                    <filter name="group_product" string="Article" context="{'group_by': 'product_id'}"/>
                    <filter name="group_partner" string="Partenaire" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Mois" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_operating_report" model="ir.actions.act_window">
        <field name="name">Détail du compte d'exploitation</field>
        <field name="res_model">sofalgri.operating.report</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_current_season': 1}</field>
        <field name="search_view_id" ref="view_operating_report_search"/>
    </record>
</odoo>
