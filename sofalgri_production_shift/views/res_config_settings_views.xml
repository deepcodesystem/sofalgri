<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_production_shift" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.production.shift</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Shifts de production" name="production_shift_setting_container">
                    <setting id="production_shift_partners" string="Destinataires du rapport de shift"
                             company_dependent="1"
                             help="Reçoivent par email le rapport des palettes produites à la fin de chaque shift.">
                        <field name="production_shift_partner_ids" widget="many2many_tags"
                               placeholder="Choisir les contacts..."/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
