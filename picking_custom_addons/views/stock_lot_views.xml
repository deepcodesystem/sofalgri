<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_inherit_archive" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.archive</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                <field name="active" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="search_product_lot_filter_inherit_archive" model="ir.ui.view">
        <field name="name">stock.lot.search.inherit.archive</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='on_hand']" position="after">
                <filter string="Hors stock" name="out_of_stock" domain="[('quant_ids', 'not any', [('location_id.usage', 'in', ('internal', 'transit')), ('quantity', '!=', 0)])]"/>
                <separator/>
                <filter string="Archivés" name="inactive" domain="[('active', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
