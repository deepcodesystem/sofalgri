<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="production_shift_view_list" model="ir.ui.view">
        <field name="name">sofalgri.production.shift.list</field>
        <field name="model">sofalgri.production.shift</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'open'" create="0">
                <field name="name" decoration-bf="1"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration" widget="float_time"/>
                <field name="user_start_id" widget="many2one_avatar_user"/>
                <field name="user_end_id" widget="many2one_avatar_user" optional="show"/>
                <field name="production_count" optional="show"/>
                <field name="pallet_count"/>
                <field name="box_count"/>
                <field name="qty_produced"/>
                <field name="component_qty" optional="show"/>
                <field name="report_sent" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'open'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="production_shift_view_form" model="ir.ui.view">
        <field name="name">sofalgri.production.shift.form</field>
        <field name="model">sofalgri.production.shift</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_end_shift" type="object" string="Terminer le shift" class="btn-primary"
                            invisible="state != 'open'"
                            confirm="Terminer le shift et envoyer le rapport des palettes produites ?"/>
                    <button name="action_send_report" type="object" string="Renvoyer le rapport"
                            invisible="state != 'done'"/>
                    <button name="action_print_report" type="object" string="Imprimer"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="user_start_id" widget="many2one_avatar_user"/>
                            <field name="date_end"/>
                            <field name="user_end_id" widget="many2one_avatar_user"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group>
                            <field name="production_count"/>
                            <field name="pallet_count"/>
                            <field name="box_count"/>
                            <field name="qty_produced"/>
                            <field name="component_qty"/>
                            <field name="report_sent"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Remarques sur le shift..."/>
                    <notebook>
                        <page string="Rapport" name="report">
                            <field name="report_html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Ordres de fabrication" name="productions">
                            <field name="production_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_finished"/>
                                    <field name="product_id"/>
                                    <field name="lot_producing_id"/>
                                    <field name="product_packaging_id"/>
                                    <field name="product_packaging_qty" sum="Colis"/>
                                    <field name="qty_produced" sum="Total"/>
                                    <field name="result_package_id"/>
                                    <field name="storage_location_id"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="production_shift_view_search" model="ir.ui.view">
        <field name="name">sofalgri.production.shift.search</field>
        <field name="model">sofalgri.production.shift</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_start_id"/>
                <filter name="open" string="En cours" domain="[('state', '=', 'open')]"/>
                <filter name="done" string="Terminés" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="date_start" string="Début" date="date_start"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_user_start" string="Démarré par" context="{'group_by': 'user_start_id'}"/>
                    <filter name="group_date_start" string="Jour" context="{'group_by': 'date_start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_production_shift" model="ir.actions.act_window">
        <field name="name">Shifts de production</field>
        <field name="res_model">sofalgri.production.shift</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun shift</p>
            <p>Démarrez un shift avec le bouton « Démarrer le shift » de la liste des ordres de fabrication.</p>
        </field>
    </record>

    <menuitem id="menu_production_shift"
              name="Shifts de production"
              parent="mrp.menu_mrp_manufacturing"
              action="action_production_shift"
              sequence="90"/>
</odoo>
