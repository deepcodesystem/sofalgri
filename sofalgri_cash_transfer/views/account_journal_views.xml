<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_cash_transfer" model="ir.ui.view">
        <field name="name">account.journal.form.cash.transfer</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="cash_transfer_target" invisible="type != 'bank'"/>
            </xpath>
        </field>
    </record>
</odoo>
