<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_unbuild_form_view_inherit_storage" model="ir.ui.view">
        <field name="name">mrp.unbuild.form.inherit.storage</field>
        <field name="model">mrp.unbuild</field>
        <field name="inherit_id" ref="mrp.mrp_unbuild_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="before">
                <field name="package_id" options="{'no_create': True}" readonly="state == 'done'"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_unbuild_form_view_simplified_inherit_storage" model="ir.ui.view">
        <field name="name">mrp.unbuild.form.simplified.inherit.storage</field>
        <field name="model">mrp.unbuild</field>
        <field name="inherit_id" ref="mrp.mrp_unbuild_form_view_simplified"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="before">
                <field name="package_id" options="{'no_create': True}" readonly="state == 'done'"/>
            </xpath>
        </field>
    </record>
</odoo>
