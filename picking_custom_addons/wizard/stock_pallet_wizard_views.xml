<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_pallet_wizard_form" model="ir.ui.view">
        <field name="name">stock.pallet.wizard.form</field>
        <field name="model">stock.pallet.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter une palette">
                <field name="picking_id" invisible="1"/>
                <field name="picking_location_dest_id" invisible="1"/>
                <field name="allowed_product_ids" invisible="1"/>
                <!-- Champs saisis à chaque palette, en tête et en grand -->
                <group string="Pesée de la palette" class="fs-4">
                    <group>
                        <field name="result_package_id" placeholder="Automatique (E001, E002...)"
                               options="{'no_create_edit': True, 'no_open': True}"/>
                        <field name="net_weight" default_focus="1"/>
                        <field name="crate_quantity"/>
                    </group>
                    <group>
                        <field name="tare"/>
                        <field name="quantity" class="fw-bold"/>
                    </group>
                </group>
                <!-- Valeurs reprises de la palette précédente, rarement modifiées -->
                <group string="Paramètres">
                    <group>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="location_dest_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="crate_product_id" options="{'no_create': True}"/>
                        <field name="crate_weight"/>
                        <field name="pallet_weight"/>
                    </group>
                </group>
                <footer>
                    <button name="action_add_and_print" type="object" string="Ajouter et imprimer" class="btn-primary" icon="fa-print"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_pallet_wizard" model="ir.actions.act_window">
        <field name="name">Ajouter une palette</field>
        <field name="res_model">stock.pallet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
