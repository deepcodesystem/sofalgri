<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_day_lot" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.day.lot</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- « Générer » reprend le lot du jour ; « Nouveau lot » démarre une nouvelle session -->
            <xpath expr="//button[@name='action_generate_serial']" position="attributes">
                <attribute name="title">Lot du jour (même numéro pour tous les calibres)</attribute>
            </xpath>
            <xpath expr="//button[@name='action_generate_serial']" position="after">
                <button name="action_generate_serial" type="object" string="Nouveau lot"
                        class="btn btn-link" context="{'new_day_lot': True}"
                        title="Nouveau numéro de lot (nouvelle session de calibrage)"
                        invisible="product_tracking != 'lot' or lot_producing_id"/>
            </xpath>
        </field>
    </record>
</odoo>
