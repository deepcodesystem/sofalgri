<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extension du formulaire produit -->
        <record id="view_product_packaging_unit_price_form" model="ir.ui.view">
            <field name="name">product.packaging.unit.price.form</field>
            <field name="model">product.packaging</field>
            <field name="inherit_id" ref="product.product_packaging_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='qty']" position="after">
                    <group>
                        <field name="standard_price_package"/>
                        <field name="unit_price_package"/>
                        <field name="currency_id"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='package_type_id']" position="after">
                    <field name="description_sale"/>
                    <field name="empty_weight"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_packaging_unit_price_tree" model="ir.ui.view">
            <field name="name">product.packaging.unit.price.tree</field>
            <field name="model">product.packaging</field>
            <field name="inherit_id" ref="product.product_packaging_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_uom_id']" position="after">
                    <field name="standard_price_package"/>
                    <field name="unit_price_package"/>
                    <field name="currency_id"/>
                    <field name="empty_weight" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>