<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_report_signature" model="ir.ui.view">
        <field name="name">res.company.form.report.signature</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Rapports" name="report_signature">
                    <group>
                        <field name="report_signature_image" widget="image" options="{'size': [260, 130]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
