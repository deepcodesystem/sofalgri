<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_position_report_list" model="ir.ui.view">
        <field name="name">sofalgri.bank.position.report.list</field>
        <field name="model">sofalgri.bank.position.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" action="action_open_source" type="object">
                <field name="currency_id" column_invisible="1"/>
                <field name="date"/>
                <field name="journal_id" optional="hide"/>
                <field name="movement_type"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="invoice_id" optional="show"/>
                <field name="notes" optional="show"/>
                <field name="amount_in" sum="Total"/>
                <field name="amount_out" sum="Total"/>
                <field name="amount" sum="Total"
                       decoration-success="amount &gt; 0"
                       decoration-danger="amount &lt; 0"/>
            </list>
        </field>
    </record>

    <record id="view_bank_position_report_pivot" model="ir.ui.view">
        <field name="name">sofalgri.bank.position.report.pivot</field>
        <field name="model">sofalgri.bank.position.report</field>
        <field name="arch" type="xml">
            <pivot string="Situation du compte bancaire" disable_linking="1">
                <field name="movement_type" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_bank_position_report_search" model="ir.ui.view">
        <field name="name">sofalgri.bank.position.report.search</field>
        <field name="model">sofalgri.bank.position.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="notes"/>
                <filter name="received" string="Entrées" domain="[('direction', '=', 'in')]"/>
                <filter name="spent" string="Sorties" domain="[('direction', '=', 'out')]"/>
                <separator/>
                <filter name="collection" string="Encaissements clients"
                        domain="[('movement_type', '=', 'collection')]"/>
                <filter name="supplier_payment" string="Paiements d'achats"
                        domain="[('movement_type', '=', 'supplier_payment')]"/>
                <filter name="cash" string="Espèces (versements et remises)"
                        domain="[('movement_type', 'in', ('cash_transfer', 'cash_deposit'))]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Type" context="{'group_by': 'movement_type'}"/>
                    <filter name="group_partner" string="Partenaire" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_journal" string="Compte bancaire" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_month" string="Mois" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bank_position_report" model="ir.actions.act_window">
        <field name="name">Détail du compte bancaire</field>
        <field name="res_model">sofalgri.bank.position.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_bank_position_report_search"/>
    </record>
</odoo>
