<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quant_package_form_inherit_crates" model="ir.ui.view">
        <field name="name">stock.quant.package.form.inherit.crates</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                <field name="active" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='pack_date']" position="after">
                <field name="tare"/>
            </xpath>
            <xpath expr="//field[@name='pack_date']" position="replace">
                <field name="packaging_datetime"/>
            </xpath>

            <xpath expr="//field[@name='quant_ids']/list/field[@name='lot_id']" position="after">
                <field name="crate_quantity"/>
            </xpath>
        </field>
    </record>

    <record id="quant_package_search_view_inherit_archive" model="ir.ui.view">
        <field name="name">stock.quant.package.search.inherit.archive</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.quant_package_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='internal']" position="after">
                <separator/>
                <filter string="Hors stock" name="empty" domain="['!', ('quant_ids.location_id.usage', 'in', ('internal', 'transit'))]"/>
                <separator/>
                <filter string="Archivés" name="inactive" domain="[('active', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
