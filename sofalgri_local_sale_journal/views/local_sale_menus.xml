<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_local_sale_invoices" model="ir.actions.act_window">
        <field name="name">Ventes locales</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_invoice_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('journal_id.is_local_sale', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <menuitem id="menu_local_sale_invoices"
              name="Ventes locales"
              parent="account.menu_finance_receivables"
              action="action_local_sale_invoices"
              sequence="2"/>
</odoo>
