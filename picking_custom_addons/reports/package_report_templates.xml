<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_package_template">
        <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="o">
            <!-- Sur une réception non validée, le lot n'existe que par son nom (lot_name) -->
            <t t-set="lot_label" t-value="o.lot_id.name or o.lot_name or ''"/>
            <div class="page">
                <div class="oe_structure"/>
                <div class="row mb-2">
                    <img t-if="o.company_id.logo" class="o_company_logo_big text-center" t-att-src="image_data_uri(o.company_id.logo)" alt="Logo"/>
                    <div t-if="o.company_id.report_header" t-field="o.company_id.report_header" class="o_company_tagline fw-bold mt-2">Company tagline</div>
                </div>
                <div class="row mb-2">
                    <h1 class="text-center">
                        <span>Fiche Palette</span>
                    </h1>
                </div>
                <table class="w-100 table table-sm table-striped">
                    <tr>
                        <td style="width: 30%;">N° de Lot</td>
                        <td><span t-out="lot_label" class="mt-2"/></td>
                    </tr>
                    <tr>
                        <td style="width:30%;">Nbre Colis</td>
                        <td><span t-esc="o.crate_quantity"></span></td>
                    </tr>
                    <tr>
                        <td style="width: 30%;">Produit</td>
                        <td><span t-field="o.product_id.display_name"/></td>
                    </tr>
                    <tr>
                        <td style="width: 30%;">Variété</td>
                        <td><span t-field="o.product_id.product_variety"/></td>
                    </tr>
                    <tr>
                        <td style="width: 30%;">Poids Brut</td>
                        <td>
                            <span t-field="o.net_weight">3.00</span>
                            <span t-field="o.product_id.uom_id.name" groups="uom.group_uom">Units</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 30%;">Tare</td>
                        <td>
                            <span t-field="o.tare">3.00</span>
                            <span t-field="o.product_id.uom_id.name" groups="uom.group_uom">Units</span>
                        </td>
                    </tr>
                    <tr>
                        <td>Poids Net</td>
                        <td>
                            <span t-esc="o.quantity">3.00</span>
                            <span t-field="o.product_id.uom_id.name" groups="uom.group_uom">Units</span>
                        </td>
                    </tr>
                </table>
                <table class="w-100 table table-sm table-striped">
                        <tbody>
                            <tr>
                                <td>
                                    <div t-if="o.result_package_id.valid_sscc" class="col-6 text-center">
                                        <t t-set="barcode" t-value="'00' + lot_label"/>
                                        <!--<t t-if="o.lot_id.pack_date" t-set="barcode" t-value="barcode + '13' + o.pack_date.strftime('%y%m%d')"/>-->
                                        <div name="datamatrix_barcode" t-out="barcode" t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 100, 'height': 100}">
                                            <div class="bg-light border-1 rounded d-flex flex-column align-items-center justify-content-center px-1 py-2 opacity-75 text-muted text-center">
                                            (package barcode)
                                            </div>
                                        </div>
                                    </div>
                                    <div t-else="" class="col-6 text-center">
                                        <div t-field="o.result_package_id.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:300px;height:70px;'}">
                                            <div class="bg-light border-1 rounded d-flex flex-column align-items-center justify-content-center px-1 py-2 opacity-75 text-muted text-center">
                                            (package barcode)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span style="border-bottom: 1px solid #000; padding-bottom: 5px;text-align: center !important">N° de Palette</span><br/>
                                    <span style="font-size:50px;font-weight: bold;line-height: 60px; text-align: center !important" t-field="o.result_package_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span t-field="o.result_package_id.packaging_datetime"/>
                                </td>
                                <td>
                                    <div t-if="o.result_package_id.package_type_id" class="o_packaging_type col">
                                        <strong>Package Type:</strong>
                                        <span t-field="o.result_package_id.package_type_id.name">Pallet</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
            </div>
        </t>
    </t>
    </template>
</odoo>