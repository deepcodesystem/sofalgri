<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_inherit_storage" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.storage</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="packaging_unit_qty" invisible="type != 'normal'"/>
                <field name="pallet_sequence_id" options="{'no_create': True, 'no_open': True}"
                       invisible="type != 'normal' or not packaging_unit_qty"/>
            </xpath>
        </field>
    </record>
</odoo>
