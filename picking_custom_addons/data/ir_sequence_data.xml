<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Palettes d'entrée (réception vrac) : E001, E002... (assistant « Ajouter une palette ») -->
        <record id="seq_quant_package_reception" model="ir.sequence">
            <field name="name">Palettes de réception</field>
            <field name="code">stock.quant.package.reception</field>
            <field name="prefix">E</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- Palettes de sortie : séquence native des colis (OF, livraison, « Mettre en colis ») -> S001, S002...
         Appliqué à chaque mise à jour du module (l'enregistrement natif est en noupdate) ;
         seuls le préfixe et le remplissage changent, le compteur est conservé. -->
    <function model="ir.sequence" name="write"
              eval="[[ref('stock.seq_quant_package')], {'prefix': 'S', 'padding': 3}]"/>
</odoo>
