<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_component_lot_wizard_form" model="ir.ui.view">
        <field name="name">mrp.component.lot.wizard.form</field>
        <field name="model">mrp.component.lot.wizard</field>
        <field name="arch" type="xml">
            <form string="Vérifier les lots des composants">
                <field name="allowed_move_ids" invisible="1"/>
                <field name="default_move_id" invisible="1"/>
                <field name="tracked_move_count" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    Saisissez le poids réel NET de vrac mis au calibrage, puis vérifiez que les palettes ci-dessous
                    sont bien celles utilisées. Changez la palette si besoin : le lot se met à jour automatiquement.
                </div>
                <div class="alert alert-danger fw-bold" role="alert" invisible="not weight_warning">
                    <field name="weight_warning"/>
                </div>
                <group>
                    <group>
                        <field name="production_id"/>
                        <field name="product_id"/>
                    </group>
                    <group invisible="tracked_move_count != 1">
                        <field name="expected_qty"/>
                        <field name="actual_qty" class="fs-4 fw-bold" default_focus="1"
                               required="tracked_move_count == 1"/>
                    </group>
                </group>
                <field name="line_ids" context="{'default_move_id': default_move_id}">
                    <list editable="bottom">
                        <field name="move_line_id" column_invisible="1"/>
                        <field name="product_id" column_invisible="1"/>
                        <field name="location_id" column_invisible="1"/>
                        <field name="move_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="package_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="lot_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="quantity" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_validate" type="object" string="Valider les lots" class="btn-primary" icon="fa-check"
                            invisible="weight_warning"/>
                    <button name="action_validate" type="object" string="Valider les lots" class="btn-primary" icon="fa-check"
                            invisible="not weight_warning"
                            confirm="Le poids réel est éloigné de la nomenclature. Confirmez-vous qu'il s'agit bien du poids NET du vrac, sans caisses ni palette ?"/>
                    <button string="Plus tard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
