<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_operating_rubric" model="ir.ui.view">
        <field name="name">product.template.form.operating.rubric</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="operating_rubric"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_list_view_operating_rubric" model="ir.ui.view">
        <field name="name">product.template.list.operating.rubric</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="operating_rubric" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
