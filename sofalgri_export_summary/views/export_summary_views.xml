<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_export_summary_list" model="ir.ui.view">
        <field name="name">account.move.export.summary.list</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="invoice_date desc, name desc">
                <field name="currency_id" column_invisible="1"/>
                <field name="export_station"/>
                <field name="export_net_weight" sum="Total"/>
                <field name="export_gps"/>
                <field name="export_truck"/>
                <field name="partner_id" string="Client"/>
                <field name="name" string="Facture"/>
                <field name="invoice_date" string="Date de chargement"/>
                <field name="export_type"/>
                <field name="export_carrier"/>
                <field name="export_plate"/>
                <field name="export_status" widget="badge"
                       decoration-success="export_status == 'arrived'"
                       decoration-warning="export_status == 'in_transit'"/>
                <field name="export_arrival_date"/>
                <field name="amount_untaxed" string="Prix" sum="Total"/>
                <field name="export_claim"/>
                <field name="export_invoice_rate"/>
                <field name="export_payment1_amount" sum="Total"/>
                <field name="export_payment1_date"/>
                <field name="export_payment1_rate"/>
                <field name="export_payment2_amount" sum="Total"/>
                <field name="export_payment2_date"/>
                <field name="export_payment2_rate"/>
                <field name="export_payment3_amount" sum="Total"/>
                <field name="export_payment3_date"/>
                <field name="export_payment3_rate"/>
                <field name="export_claim_amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_export_summary_search" model="ir.ui.view">
        <field name="name">account.move.export.summary.search</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Facture"/>
                <field name="partner_id" string="Client"/>
                <filter name="current_season" string="Saison en cours" domain="[('export_current_season', '=', True)]"/>
                <separator/>
                <filter name="invoice_date" string="Date de facture" date="invoice_date"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Mois de facture" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_export_summary" model="ir.actions.act_window">
        <field name="name">Synthèse des exports</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('fiscal_position_id.name', 'ilike', 'Export')]</field>
        <field name="context">{'search_default_current_season': 1, 'default_move_type': 'out_invoice'}</field>
        <field name="search_view_id" ref="view_export_summary_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_export_summary_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>

    <menuitem id="menu_export_summary"
              name="Synthèse des exports"
              parent="synconics_bi_dashboard.parent_dashboard_menu"
              action="action_export_summary"
              groups="account.group_account_invoice,sales_team.group_sale_manager"
              sequence="5"/>
</odoo>
