<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_own_invoices" model="ir.module.category">
        <field name="name">Sofalgri</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_own_invoices" model="res.groups">
        <field name="name">Mes factures uniquement</field>
        <field name="category_id" ref="module_category_own_invoices"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Crée, valide et paie ses propres factures, clients et fournisseurs, sans voir les autres.</field>
    </record>

    <!-- Les règles de groupe s'additionnent : celle du groupe Facturation donne accès à tout.
         Seule une règle globale (sans groupe) peut restreindre, d'où le test du groupe dans le domaine. -->
    <record id="rule_own_invoices_move" model="ir.rule">
        <field name="name">Mes factures uniquement : écritures</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('create_uid', '=', user.id)] if user.has_group('sofalgri_own_invoices.group_own_invoices') else [(1, '=', 1)]</field>
    </record>

    <record id="rule_own_invoices_move_line" model="ir.rule">
        <field name="name">Mes factures uniquement : lignes d'écriture</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('move_id.create_uid', '=', user.id)] if user.has_group('sofalgri_own_invoices.group_own_invoices') else [(1, '=', 1)]</field>
    </record>

    <record id="rule_own_invoices_payment" model="ir.rule">
        <field name="name">Mes factures uniquement : paiements</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="domain_force">[('create_uid', '=', user.id)] if user.has_group('sofalgri_own_invoices.group_own_invoices') else [(1, '=', 1)]</field>
    </record>

    <record id="rule_own_invoices_partial_reconcile" model="ir.rule">
        <field name="name">Mes factures uniquement : lettrages</field>
        <field name="model_id" ref="account.model_account_partial_reconcile"/>
        <field name="domain_force">['|', ('debit_move_id.move_id.create_uid', '=', user.id), ('credit_move_id.move_id.create_uid', '=', user.id)] if user.has_group('sofalgri_own_invoices.group_own_invoices') else [(1, '=', 1)]</field>
    </record>

    <!-- L'analyse des factures n'a pas de créateur : aucune ligne pour ce groupe. -->
    <record id="rule_own_invoices_report" model="ir.rule">
        <field name="name">Mes factures uniquement : analyse des factures</field>
        <field name="model_id" ref="account.model_account_invoice_report"/>
        <field name="domain_force">[(0, '=', 1)] if user.has_group('sofalgri_own_invoices.group_own_invoices') else [(1, '=', 1)]</field>
    </record>
</odoo>
