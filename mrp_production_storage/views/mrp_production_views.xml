<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_storage" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.storage</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Après la ligne de la nomenclature (bom_id est dans une div o_row, sans libellé) -->
            <xpath expr="//div[@name='bom_div']" position="after">
                <field name="storage_parent_location_id" invisible="1"/>
                <field name="product_packaging_id" options="{'no_create': True, 'no_open': True}"
                       readonly="state in ('done', 'cancel')"/>
                <field name="product_packaging_qty" invisible="not product_packaging_id"
                       readonly="state in ('done', 'cancel')"/>
                <field name="storage_location_id" options="{'no_create': True, 'no_open': True}"
                       readonly="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
